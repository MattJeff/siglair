####################################################################
# Siglair — configuration                                          #
#                                                                  #
#   cp .env.example .env                                           #
#                                                                  #
# Tout ce qui est marqué OPTIONNEL peut rester vide : la           #
# fonctionnalité correspondante se désactive proprement et le      #
# bouton disparaît du front (GET /api/config). Rien ne plante.     #
# Une variable vide vaut une variable absente.                     #
####################################################################


# ============================== OBLIGATOIRE ==============================

# Base de données.
#   - en local avec scripts/dev.sh  : hôte localhost (Postgres est publié sur 5432)
#   - dans docker compose           : surchargé automatiquement vers l'hôte `db`
DATABASE_URL=postgres://siglair:siglair@localhost:5432/siglair

# Base externe pour Docker Compose en production. Si cette variable est remplie,
# les conteneurs API et renderer l'utilisent à la place de la base locale `db`.
# Pour Supabase : utilisez la connexion directe si la VM a IPv6, sinon le pooler
# en mode session (port 5432). Évitez le pooler transactionnel avec SQLx.
# SIGLAIR_DATABASE_URL=postgres://postgres.jxyxysoknqbsnbjyyttz:[MOT_DE_PASSE]@aws-[REGION].pooler.supabase.com:5432/postgres?sslmode=require

# Clé de signature des cookies. 32 octets minimum, en base64.
# Générez-la maintenant :   openssl rand -base64 32
# La changer déconnecte tout le monde. Ne la commitez jamais.
SIGLAIR_SECRET_KEY=

# Sel de hachage des adresses IP (aucune IP n'est stockée en clair, contrat §4.1).
# Générez-la :   openssl rand -hex 16
# La changer rend les anciens hachages incomparables — sans gravité, mais définitif.
SIGLAIR_IP_SALT=


# ============================== URL ==============================

# Origine du front : liens des e-mails, redirections OAuth, cookies.
#   dev  (vite)                     : http://localhost:5173
#   docker compose sans proxy       : http://localhost:3000
#   production                      : https://siglair.app
APP_URL=http://localhost:5173

# Origine publique servie aux clients mail : c'est ce qui est écrit dans le
# <img src="..."> collé dans Gmail. Doit être joignable depuis Internet en prod.
#   dev / compose                   : http://localhost:8080
#   production                      : https://siglair.app
PUBLIC_URL=http://localhost:8080

# Domaine servi par Caddy. Vide = HTTP sur :80 (local).
# Renseignez le domaine (sans https://) pour obtenir le TLS automatique.
# SITE_ADDRESS=siglair.app

# Port d'écoute de l'API, et emplacement des GIF/PNG/assets sur disque.
# Surchargés dans docker compose, à ne toucher qu'en local.
PORT=8080
STORAGE_DIR=./data/storage


# ============================== BINAIRES DE RENDU ==============================

# Uniquement pour un lancement hors Docker. Dans l'image, ces chemins sont déjà
# posés (/usr/bin/chromium, /usr/bin/ffmpeg).
#   macOS : CHROME_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
#   Linux : CHROME_PATH=/usr/bin/chromium
# CHROME_PATH=
FFMPEG_PATH=ffmpeg


# ============================== GOOGLE — OPTIONNEL ==============================
# Bouton « Continuer avec Google ». Sans ces deux valeurs, il n'est pas affiché.
#
# 1. https://console.cloud.google.com/projectcreate  → créez un projet.
# 2. https://console.cloud.google.com/auth/branding  → écran de consentement :
#      type « Externe », nom de l'app « Siglair », e-mail d'assistance, domaine
#      autorisé « siglair.app ». Publiez-le (sinon 100 utilisateurs de test max).
# 3. https://console.cloud.google.com/auth/scopes    → scopes : openid, email, profile.
#      Rien de plus : demander l'accès au Drive ferait passer par une revue Google.
# 4. https://console.cloud.google.com/apis/credentials
#      → « Créer des identifiants » → « ID client OAuth » → type « Application Web ».
#      Origines JavaScript autorisées :
#          http://localhost:5173
#          https://siglair.app
#      URI de redirection autorisés — EXACTEMENT ces chaînes, une par ligne :
#          http://localhost:5173/api/auth/google/callback
#          https://siglair.app/api/auth/google/callback
#      (une URI qui diffère d'un slash final donne un redirect_uri_mismatch)
# 5. Copiez l'ID client et le secret ci-dessous.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ============================== APPLE — OPTIONNEL ==============================
# Bouton « Continuer avec Apple ». Exige un compte Apple Developer payant (99 €/an)
# et un domaine en HTTPS : Apple refuse localhost comme Return URL. En local, ce
# bouton reste donc masqué — c'est normal, ce n'est pas une erreur.
#
# 1. https://developer.apple.com/account/resources/identifiers/list/bundleId
#      → « + » → App IDs → App → description « Siglair », Bundle ID
#        « app.siglair.web » → cochez « Sign in with Apple ». Enregistrez.
# 2. https://developer.apple.com/account/resources/identifiers/list/serviceId
#      → « + » → Services IDs → description « Siglair Web »,
#        identifiant « app.siglair.signin » → c'est votre APPLE_CLIENT_ID.
#      → Configure → Primary App ID = l'App ID de l'étape 1
#        Domains and Subdomains : siglair.app
#        Return URLs            : https://siglair.app/api/auth/apple/callback
#        (Apple poste en form_post sur cette URL : elle doit être en https)
# 3. https://developer.apple.com/account/resources/authkeys/list
#      → « + » → nom « Siglair Sign in », cochez « Sign in with Apple »,
#        Configure → Primary App ID de l'étape 1 → Continue → Register.
#      → Téléchargez le .p8 (téléchargeable UNE SEULE FOIS) et notez le Key ID.
# 4. https://developer.apple.com/account  → section Membership : Team ID (10 car.).
# 5. Collez le contenu du .p8 sur une seule ligne en remplaçant les retours à la
#    ligne par \n, entre guillemets :
#      APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----"
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=


# ============================== RESEND — OPTIONNEL ==============================
# E-mails transactionnels : lien magique de connexion, invitations d'équipe.
# Sans ces valeurs, la connexion par e-mail est masquée (OAuth reste utilisable).
#
# 1. https://resend.com/domains  → « Add Domain » → siglair.app → région EU
#      (Irlande) si vos utilisateurs sont européens.
#      Resend affiche 3 enregistrements DNS à créer chez votre registrar :
#        MX    send.siglair.app          feedback-smtp.eu-west-1.amazonses.com  (prio 10)
#        TXT   send.siglair.app          "v=spf1 include:amazonses.com ~all"
#        TXT   resend._domainkey...      (clé DKIM fournie par Resend)
#      Puis « Verify DNS Records ». Comptez quelques minutes de propagation.
#      Ajoutez aussi, fortement recommandé pour ne pas finir en spam :
#        TXT   _dmarc.siglair.app        "v=DMARC1; p=none;"
# 2. https://resend.com/api-keys  → « Create API Key », permission « Sending access »,
#      domaine = siglair.app. La clé (re_...) n'est affichée qu'une fois.
# 3. RESEND_FROM doit utiliser le domaine vérifié, sinon Resend renvoie une 403.
RESEND_API_KEY=
RESEND_FROM=Siglair <bonjour@siglair.app>


# ============================== STRIPE — OPTIONNEL ==============================
# Paiement. Sans ces valeurs, la page de tarifs s'affiche mais les boutons
# d'abonnement sont masqués. Commencez en mode Test (bandeau orange du dashboard).
#
# 1. https://dashboard.stripe.com/test/apikeys
#      → « Secret key » (sk_test_... ; en production sk_live_...).
# 2. https://dashboard.stripe.com/test/products/create
#      Produit « Siglair Pro »  → tarif récurrent mensuel 7,90 € EUR
#      Produit « Siglair Team » → tarif récurrent mensuel 5,90 € EUR,
#        cochez « par unité » (tarification par siège, minimum 3 sièges).
#      Ouvrez chaque tarif et copiez son ID (price_..., pas l'ID du produit prod_...).
#      Les prix annuels (79 € et 59 €/siège) s'ajoutent comme second tarif du
#      même produit quand vous en aurez besoin.
# 3. https://dashboard.stripe.com/test/webhooks/create
#      Endpoint URL : https://siglair.app/api/stripe/webhook
#      Événements à cocher, exactement ceux-ci :
#        checkout.session.completed
#        customer.subscription.created
#        customer.subscription.updated
#        customer.subscription.deleted
#        invoice.paid
#        invoice.payment_failed
#      Puis « Reveal signing secret » → whsec_...
#      En local, pas d'URL publique : utilisez le CLI Stripe
#        stripe listen --forward-to localhost:8080/api/stripe/webhook
#      qui affiche son propre whsec_ à mettre ici.
# 4. https://dashboard.stripe.com/test/settings/billing/portal
#      Activez le portail client (bouton « Gérer mon abonnement ») et autorisez
#      l'annulation et le changement de tarif.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=


# ============================== IA — OPTIONNEL ==============================
# « Colle ton site, récupère ta signature » (contrat §6bis).
# Sans clé, la fonctionnalité NE DISPARAÎT PAS : le composeur applique la palette
# extraite du site à trois modèles et renvoie trois propositions. Moins finement
# adaptées, parfaitement utilisables. /api/config annonce donc toujours ai: true.
#
# Un seul client, compatible OpenAI (§6bis.3) : changer de fournisseur — xAI, OpenAI,
# OpenRouter, Groq, un modèle local — c'est changer ces deux premières variables,
# pas une ligne de code.
#
# Fournisseur retenu : xAI (Grok). https://console.x.ai → « API Keys » pour la clé.
#
# AI_MODEL n'a AUCUNE valeur par défaut, volontairement : un nom de modèle inventé donne
# une 404 en production, sur la fonctionnalité d'acquisition. Absent = repli déterministe,
# ce qui est un mauvais jour, pas une panne.
# Où trouver le nom exact :
#   - la liste des modèles de votre compte : curl https://api.x.ai/v1/models \
#         -H "Authorization: Bearer $AI_API_KEY" | jq -r '.data[].id'
#   - ou, plus simple, reprenez celui déjà utilisé par votre générateur de guides.
#
# Vérifier que le trio fonctionne avant de compter dessus :
#   curl -s $AI_BASE_URL/chat/completions -H "Authorization: Bearer $AI_API_KEY" \
#        -H 'content-type: application/json' \
#        -d '{"model":"'"$AI_MODEL"'","messages":[{"role":"user","content":"dis OK"}]}' | jq .
#
# Le modèle ne reçoit QUE la marque extraite du site analysé (nom, couleurs, accroche) —
# jamais le nom, l'email ni le téléphone de vos utilisateurs (contrat §6bis.3). Pensez
# tout de même à nommer le fournisseur retenu comme sous-traitant dans la politique de
# confidentialité avant l'ouverture commerciale.
AI_BASE_URL=https://api.x.ai/v1
AI_MODEL=
AI_API_KEY=


# ============================== DOCKER COMPOSE ==============================
# Ports publiés sur l'hôte, à changer si 5432/8080/3000 sont déjà pris.
# POSTGRES_PORT=5432
# API_PORT=8080
# WEB_PORT=3000
