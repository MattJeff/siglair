# SITE_ADDRESS=:80 → HTTP local. SITE_ADDRESS=siglair.com → TLS
# automatique via Let's Encrypt. SITE_WWW_ADDRESS couvre www en HTTPS
# avant de rediriger vers l'apex.
{$SITE_WWW_ADDRESS} {
	redir {$SITE_CANONICAL_URL}{uri} permanent
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# Tout ce que l'API sert : l'app, les URL publiques collées dans les mails
	# (/s, /c, /v) et les fichiers du stockage (/f). Le reste est le SPA.
	#
	# /v/* est la page de vérification. Oublier de l'ajouter ici ne casse rien en local —
	# le binaire répond directement — mais en production Caddy la servirait au SPA React,
	# qui afficherait sa page « introuvable » sur une URL imprimée dans des e-mails déjà
	# partis. Le genre de panne qui ne se voit qu'après le déploiement.
	@api path /api/* /s/* /c/* /v/* /f/* /health /ready
	handle @api {
		header X-Robots-Tag "noindex, nofollow"
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:80
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin

		# HSTS : une fois le domaine visité, le navigateur REFUSE le HTTP en clair pendant un
		# an, sans même émettre la requête. Ça ferme la fenêtre de la toute première requête,
		# celle qu'un réseau hostile peut détourner avant que la redirection 301 arrive.
		# Sans `preload` volontairement : l'inscription à la liste des navigateurs est
		# difficilement réversible et n'a de sens qu'une fois le domaine stabilisé.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"

		# Anti-détournement de clic. `frame-ancestors 'self'` et non `DENY` : l'éditeur affiche
		# son propre aperçu dans une iframe de même origine, que DENY casserait.
		# Aucune directive `script-src` ici — une CSP de scripts se mesure avant de s'imposer,
		# et une CSP cassée sur une SPA se voit par une page blanche, pas par un avertissement.
		Content-Security-Policy "frame-ancestors 'self'"

		# Rien dans Siglair n'a besoin de la caméra, du micro ou de la position.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
	}
}
