# siglair.com sert la console d'InternationalAgent, et l'API derrière elle.
#
# Deux conteneurs, un domaine. `web` est la console (Next.js, dépôt
# internationagent-web) et c'est elle que voit un humain ; `api` est
# agentos-server, et **elle n'est publique que là où elle doit l'être** — les
# webhooks qu'un fournisseur signe, le retour OAuth qu'un navigateur suit, les
# annuaires qu'un vérificateur lit sans credential, la porte A2A, et le serveur
# MCP qu'un Claude Code appelle depuis dehors.
#
# Tout le reste de `/v1/*` n'est joignable que depuis le réseau des conteneurs :
# la console parle à `http://api:8080` **côté serveur**, sa clé bearer ne quitte
# jamais son processus, et il n'existe donc aucune raison de publier ces routes.
# Une API d'entreprise exposée « au cas où » est une surface qu'il faut ensuite
# défendre.
#
# SITE_ADDRESS=:80 → HTTP local. SITE_ADDRESS=siglair.com → TLS automatique via
# Let's Encrypt. SITE_WWW_ADDRESS couvre www avant de rediriger vers l'apex.
#
# NOTE : le domaine est derrière Cloudflare. Si Cloudflare est en mode « proxifié »
# avec un certificat d'origine, c'est Cloudflare qui parle à Caddy et le challenge
# HTTP-01 de Let's Encrypt peut ne jamais arriver. Voir le rapport de transposition.
{$SITE_WWW_ADDRESS} {
	redir {$SITE_CANONICAL_URL}{uri} permanent
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# --- ce qui ne doit JAMAIS être public ---------------------------------
	#
	# SPEC.md §20 : /livez, /readyz et /metrics sont HORS de la pile
	# d'authentification — aucun credential ne les protège, par construction,
	# parce qu'une sonde qui a besoin d'une clé est une sonde qui signale une
	# panne le jour où le trousseau est mal configuré.
	#
	# Ce qu'ils publient à qui les lit :
	#   /metrics → le mélange des raisons de refus et la profondeur de la file
	#              d'approbation ;
	#   /readyz  → le retard de l'outbox, et la liste des adaptateurs en mock ;
	#   /livez   → peu de chose, mais rien qui ait à être joignable de dehors.
	#
	# 404 et pas 403 : un 403 confirme que le chemin existe.
	@prive path /metrics /livez /readyz
	handle @prive {
		respond 404
	}

	# --- l'API, sur les seuls chemins qui doivent être publics --------------
	#
	# Chacun l'est par nécessité et pour une raison qui lui est propre :
	#   POST /v1/webhooks/{path}     un fournisseur signe, il n'a pas de clé à nous ;
	#   GET  /v1/mcp/oauth/callback  c'est un navigateur qui revient ;
	#   GET  /.well-known/agent-card.json
	#   GET  /.well-known/http-message-signatures-directory
	#        un vérificateur qui n'a jamais entendu parler de nous n'a rien pour
	#        s'authentifier, et une clé que personne ne peut lire ne vérifie rien ;
	#   POST /a2a/jsonrpc            l'agent d'une autre entreprise, qui porte
	#        une clé de tenant : c'est le serveur qui l'authentifie, pas Caddy.
	#   POST /v1/mcp/server          le serveur MCP, que le fondateur branche sur
	#        Claude Code depuis son Mac : le client est dehors, il n'y a pas de
	#        session de console à emprunter, et il porte une clé de tenant que le
	#        serveur vérifie — Caddy, ici non plus, ne défend rien.
	#
	# Ce chemin est écrit EN ENTIER, et surtout pas `/v1/mcp/*`. Le joker
	# publierait tout le catalogue d'intégrations, qui n'a rien à faire dehors :
	# `/v1/mcp/catalog`, `/v1/mcp/connect`, `/v1/mcp/servers` (et son
	# `/{server}/discover`, et `/{server}/tools/{tool}`), `/v1/mcp/oauth/start`.
	# Ces routes-là sont celles de la console, qui les appelle par
	# `http://api:8080` sans jamais sortir du réseau des conteneurs. Le matcher
	# `path` de Caddy est exact sans joker : `/v1/mcp/server` ne fait donc pas
	# entrer `/v1/mcp/servers`, dont il n'est que le préfixe — c'est une lettre
	# d'écart entre le serveur MCP et l'annuaire des connecteurs d'un tenant.
	#
	# PAS de limite de débit ici. Celle du serveur est de 600 requêtes par tenant
	# et par minute, appliquée APRÈS l'authentification : le trafic anonyme sur
	# les chemins ci-dessus n'est donc limité par rien dans ce processus. C'est à
	# Cloudflare de le faire, pas à un plugin Caddy qu'il faudrait compiler.
	@api path /v1/webhooks/* /v1/mcp/oauth/callback /v1/mcp/server /a2a/* /.well-known/*
	handle @api {
		header X-Robots-Tag "noindex, nofollow"
		reverse_proxy api:8080
	}

	# --- la console ----------------------------------------------------------
	#
	# Tout le reste. Elle garde sa propre garde de session : `/` sans cookie
	# redirige vers `/connexion`, et son proxy `/api/agents/*` exige la session
	# AVANT de relayer quoi que ce soit vers `api`. Caddy ne défend rien ici et
	# ne doit pas faire semblant.
	handle {
		reverse_proxy web:3000
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin

		# HSTS : une fois le domaine visité, le navigateur REFUSE le HTTP en clair
		# pendant un an. Sans `preload` volontairement — l'inscription à la liste
		# des navigateurs est difficilement réversible.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"

		# Une console d'administration n'a aucune raison d'être encadrée par qui
		# que ce soit : `frame-ancestors 'none'` est ce qui empêche un clic
		# détourné d'approuver un paiement dans une iframe invisible.
		Content-Security-Policy "frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
	}
}
