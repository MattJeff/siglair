# Front React/Vite → fichiers statiques servis par nginx.
#
# Choix : nginx, pas « servi par l'API ». L'API sert /api, /s, /c, /f ; y greffer
# un fallback SPA obligerait à connaître la liste des routes React côté Rust, et
# c'est un couplage qui casse à chaque nouvelle page. nginx fait try_files en une
# ligne. Le routage entre le front et l'API est fait par Caddy (docker/Caddyfile).
#
# Contexte de build : la racine du dépôt (cf. compose.yml).

FROM node:22-alpine AS build
WORKDIR /app

# L'arborescence du dépôt est reproduite telle quelle, et ce n'est pas un détail :
# `web/src/pages/Editor.tsx` importe `../../../src/render/anim.css`, le CSS d'animation
# du renderer Rust. Le contrat §3.2 impose qu'il n'existe qu'une seule fois — le front
# consomme le fichier du back plutôt que d'en garder une copie qui divergerait.
# Un `COPY web/ ./` aplatirait cette structure et l'import sortirait de /app.
COPY web/package.json web/package-lock.json ./web/
RUN cd web && npm ci

COPY src/render/anim.css ./src/render/anim.css
COPY web/ ./web/
ARG VITE_PUBLIC_HOST
ENV VITE_PUBLIC_HOST=${VITE_PUBLIC_HOST}
RUN cd web && npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/web/dist /usr/share/nginx/html

# Les fichiers d'assets Vite portent un hash dans leur nom : cache immuable.
# Les routes publiques ont chacune leur HTML pré-rendu. Les routes privées utilisent
# un shell SPA noindex et les chemins publics inconnus restent de vraies 404.
RUN printf '%s\n' \
    'server {' \
    '  listen 80;' \
    '  root /usr/share/nginx/html;' \
    '  gzip on;' \
    '  gzip_types text/plain text/css application/javascript application/json application/xml image/svg+xml;' \
    '  location ^~ /assets/ {' \
    '    try_files $uri =404;' \
    '    expires 1y;' \
    '    add_header Cache-Control "public, immutable";' \
    '  }' \
    '  location = /robots.txt { try_files $uri =404; add_header Cache-Control "public, max-age=3600"; }' \
    '  location = /sitemap.xml { try_files $uri =404; add_header Cache-Control "public, max-age=3600"; }' \
    '  location = /llms.txt { try_files $uri =404; add_header Cache-Control "public, max-age=3600"; }' \
    '  location ~* \\.(?:png|jpe?g|gif|webp|svg|ico|woff2?|webmanifest)$ {' \
    '    try_files $uri =404;' \
    '    expires 7d;' \
    '    add_header Cache-Control "public, max-age=604800";' \
    '  }' \
    '  location = /spa.html {' \
    '    internal;' \
    '    add_header X-Robots-Tag "noindex, nofollow" always;' \
    '    add_header Cache-Control "no-store" always;' \
    '  }' \
    '  location = /login { rewrite ^ /spa.html last; }' \
    '  location = /invite { rewrite ^ /spa.html last; }' \
    '  location ^~ /invite/ { rewrite ^ /spa.html last; }' \
    '  location = /onboarding { rewrite ^ /spa.html last; }' \
    '  location = /app { rewrite ^ /spa.html last; }' \
    '  location ^~ /app/ { rewrite ^ /spa.html last; }' \
    '  location ^~ /legal/ {' \
    '    add_header X-Robots-Tag "noindex, nofollow" always;' \
    '    add_header Cache-Control "no-cache";' \
    '    try_files $uri/index.html =404;' \
    '  }' \
    '  location = / {' \
    '    add_header Cache-Control "no-cache";' \
    '    try_files /index.html =404;' \
    '  }' \
    '  location / {' \
    '    add_header Cache-Control "no-cache";' \
    '    try_files $uri/index.html =404;' \
    '  }' \
    '}' > /etc/nginx/conf.d/default.conf

HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
    CMD wget -qO /dev/null http://127.0.0.1/ || exit 1
